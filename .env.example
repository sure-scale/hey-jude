# Minimal local setup
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# Local Ollama model used by the anonymization layer
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b

# Default demo destination also stays local through LiteLLM + Ollama.
# Advanced users can replace these with OpenAI, Anthropic, Gemini, Azure, etc.
EXTERNAL_LLM_MODEL=ollama_chat/qwen3.5:4b
EXTERNAL_LLM_API_BASE=http://localhost:11434

# Gateway auth
API_KEY=sk-heyjude-dev

# reject, warn, or skip unreadable documents/images without a text layer
DOCUMENT_UNREADABLE_ACTION=reject

# Optional: domain-specific PII detection (see examples/ for templates).
# Custom Presidio recognizers (regex) extend the safety net + mechanical mode.
# CUSTOM_RECOGNIZERS_PATH=examples/custom_recognizers.example.yaml
# Known-entity dictionary: firm-maintained client/personnel/matter lists. Listed
# entities are guaranteed-replaced before the prompt reaches the LLM.
# KNOWN_ENTITIES_PATH=examples/known_entities.example.yaml
