# Minimal local setup
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# Local Ollama model used by the anonymization layer
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b

# Default demo destination also stays local through LiteLLM + Ollama.
# Advanced users can replace these with OpenAI, Anthropic, Gemini, Azure, etc.
EXTERNAL_LLM_MODEL=ollama_chat/qwen3.5:4b
EXTERNAL_LLM_API_BASE=http://localhost:11434

# In-jurisdiction sovereign destination for irreducible-PII requests: self-hosted
# OSS on compute not subject to US compulsion. Defaults to the same local endpoint.
EXTERNAL_LLM_MODEL_SENSITIVE=ollama_chat/qwen3.5:4b
EXTERNAL_LLM_MODEL_SENSITIVE_API_BASE=http://localhost:11434

# Policy for irreducible PII (cannot be masked below the re-id threshold):
# BLOCK refuses, ASK confirms, WARN routes to the sovereign model and flags it,
# ALLOW sends to the US frontier model anyway. Per-request override: X-Heyjude-Policy header.
IRREDUCIBLE_POLICY=WARN

# Gateway auth
API_KEY=sk-heyjude-dev

# reject, warn, or skip unreadable documents/images without a text layer
DOCUMENT_UNREADABLE_ACTION=reject

# Optional: domain-specific PII detection (see examples/ for templates).
# Custom Presidio recognizers (regex) extend the safety net + mechanical mode.
# CUSTOM_RECOGNIZERS_PATH=examples/custom_recognizers.example.yaml
# Known-entity dictionary: firm-maintained client/personnel/matter lists. Listed
# entities are guaranteed-replaced before the prompt reaches the LLM.
# KNOWN_ENTITIES_PATH=examples/known_entities.example.yaml

# Optional: request-level audit logging (off by default). Tamper-evident,
# hash-chained JSONL meant to be kept internal. Default content level stores no
# raw client PII -- only metadata plus SHA-256 digests of input/output.
# AUDIT_ENABLED=true
# AUDIT_DESTINATION=audit/audit.jsonl       # "stdout" or a file path
# AUDIT_CONTENT_LEVEL=metadata              # metadata | anonymized | full
# AUDIT_ROTATION=monthly                    # none | daily | monthly
# AUDIT_FAILURE_MODE=ignore                 # ignore (never block) | fail (fail-closed)
# AUDIT_HMAC_KEY=                           # set to bind the chain to a secret
# AUDIT_LOG_IP=true
# AUDIT_TRUST_FORWARDED_FOR=false           # set true only behind a trusted proxy
# AUDIT_MATTER_HEADER=X-Heyjude-Matter-Id
# AUDIT_ACTOR_HEADER=                        # opt-in attorney attribution, e.g. X-Heyjude-Actor
